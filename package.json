{
  "name": "@walidsj/react-ui",
  "version": "0.1.2",
  "description": "Accessible React components styled with Tailwind CSS v4 and built on Base UI primitives.",
  "license": "MIT",
  "author": "walidsj (https://github.com/walidsj)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walidsj/walid-ui.git"
  },
  "homepage": "https://github.com/walidsj/walid-ui#readme",
  "bugs": {
    "url": "https://github.com/walidsj/walid-ui/issues"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "tailwindcss",
    "base-ui",
    "typescript"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "bun run clean && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5"
  }
}
